{
  "name": "restock-alerts",
  "version": "1.0.0",
  "private": true,
  "description": "Durable back-in-stock alerts with a storefront, embeddable form, and operations dashboard",
  "type": "module",
  "engines": { "node": ">=24.13.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "demo": "node tools/demo.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node tools/check.js"
  }
}
